# ─────────────────────────────────────────────────────────────
#  ESTONE — налаштування сервера
# ─────────────────────────────────────────────────────────────

# Приватні файли не відкриваються з браузера
<FilesMatch "^(leads\.csv|send\.config\.php|\.estone_chat|\.version)$">
  Require all denied
</FilesMatch>

# Службові файли
RedirectMatch 404 ^/docs/

# ── Одна адреса для кожної сторінки ──────────────────────────
# Без цього Google бачить /kukhnia/ і /kukhnia/index.html як дві
# різні сторінки і половину з них викидає з індексу як копію.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Завжди https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://estone.com.ua/$1 [R=301,L]

  # Завжди без www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://estone.com.ua/$1 [R=301,L]

  # /сторінка/index.html -> /сторінка/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # Старі адреси карти сайту зі старого сайту
  RewriteRule ^sitemapsindex\.xml$ /sitemap.xml [R=301,L]
  RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]
</IfModule>

ErrorDocument 404 /404.html
DirectoryIndex index.html

# ── Кешування ────────────────────────────────────────────────
# HTML не кешуємо: зміни на сайті видно одразу, без інкогніто.
# Стилі, скрипти й фото кешуємо надовго — у їхніх адресах є ?v=,
# який міняється при кожному оновленні, тож браузер підтягне нове сам.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(pdf|zip)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ── Стиснення ────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
